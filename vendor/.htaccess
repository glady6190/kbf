# ============================================
# COMPOSER LIBRARIES - NO WEB ACCESS
# Loaded by PHP only (for example PHPMailer), never served or run directly.
# ============================================

Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
    # Also inside FilesMatch, so the root "\.php$ -> Require all granted"
    # rule cannot re-open anything in this folder.
    <FilesMatch ".*">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
    <FilesMatch ".*">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
