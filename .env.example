# KBF-UK settings read by the site (copy to .env and fill in).
# One KEY=value per line, no quotes around values, no spaces around "=".
# REQUIRED keys must be set; when one is missing the site logs a clear
# message (the key name only) once a day and falls back safely.
# Use long random values for passwords and keys (20+ characters).

# --- Database ---
# Optional: database server (default localhost)
DB_HOST=localhost
# REQUIRED: database name
DB_NAME=your_database_name
# REQUIRED: database user
DB_USER=your_database_user
# REQUIRED: database password (long and random)
DB_PASS=your_database_password

# --- Sessions ---
# REQUIRED: secret mixed into the browser fingerprint of each session
SESSION_FINGERPRINT_SALT=generate_a_long_random_string_here

# --- Email (SMTP) ---
# REQUIRED: password of the sending mail account; without it no email is sent
SMTP_PASSWORD=your_smtp_password
# Optional: mail server (default smtp.hostinger.com)
SMTP_HOST=smtp.hostinger.com
# Optional: 465 (SSL, default) or 587 (STARTTLS)
SMTP_PORT=465
# Optional: sending account (default noreply@kbf-uk.org)
SMTP_USERNAME=noreply@kbf-uk.org

# --- Optional: separate service for broadcasts (Brevo, Amazon SES, Mailgun...) ---
# Set ALL FIVE to send broadcasts through that service with its own daily
# limit; the Hostinger mailbox above is then used only for other emails.
# Leave them all out to send everything through the Hostinger mailbox.
# BULK_SMTP_HOST=smtp-relay.example.com
# 465 (SSL) or 587 (STARTTLS)
# BULK_SMTP_PORT=587
# BULK_SMTP_USERNAME=your_bulk_service_login
# BULK_SMTP_PASSWORD=your_bulk_service_password
# Most broadcast emails in any 24 hours (sent evenly: at most limit / 24 an hour)
# BULK_DAILY_LIMIT=1000
# Optional: the sender address for broadcasts (must be allowed by the
# service; default: SMTP_USERNAME)
# BULK_SMTP_FROM=news@kbf-uk.org

# --- Registration captcha ---
# REQUIRED: reCAPTCHA secret key; without it every registration is refused.
# (The public site key is written in register.html, data-sitekey; change
# both together.)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# --- 2-step verification ---
# REQUIRED for 2-step: 64 hex characters (32 random bytes), e.g. from:
#   php -r "echo bin2hex(random_bytes(32));"
# Keep a copy somewhere safe outside the web folder: if it is lost or
# changed, every saved 2-step secret becomes unreadable.
TWO_FACTOR_KEY=generate_64_hex_characters_here
