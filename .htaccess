# ============================================
# SECURITY CONFIGURATION
# ============================================
# Prevent directory listing
Options -Indexes
# Follow symbolic links (needed for routing)
Options +FollowSymLinks
# Enable rewrite engine
RewriteEngine On

# ============================================
# ALLOW PHP EXECUTION (except in uploads)
# ============================================
# By default, allow PHP execution everywhere. This comes BEFORE the deny
# rules below: a later section wins, so every deny below overrides it.
<FilesMatch "\.php$">
    Require all granted
</FilesMatch>

# ============================================
# PROTECT SENSITIVE FILES
# ============================================
# Block access to config files
<FilesMatch "^(config|security-init)\.php$">
    Require all denied
</FilesMatch>

# Block access to hidden files (like .htaccess, .env, .git)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block access to backup and sensitive file types (.sql, .md, .log, .env ...)
<FilesMatch "\.(bak|config|sql|md|log|env|sh|ini|lock|dist)$">
    Require all denied
</FilesMatch>

# Block Composer files and the old default page
<FilesMatch "^(composer\.json|composer\.lock|default\.php)$">
    Require all denied
</FilesMatch>

# Block whole folders: Composer libraries, local tool settings, database
# scripts, runtime storage and scheduled jobs (each also has its own rules
# where possible)
RewriteRule ^(vendor|\.claude|database|storage|jobs|tools|docs)(/|$) - [F,L]
RewriteRule (^|/)\.env - [F,L]
# The stylesheet build settings (only used to build assets/css/site.css)
RewriteRule ^tailwind\.config\.js$ - [F,L]

# ============================================
# COMPRESSION AND BROWSER CACHING (static files)
# Works on Apache (mod_deflate, mod_headers) and LiteSpeed (which compresses
# by itself and honours the same Header lines). PHP responses set their own
# Cache-Control and are not touched here, except share-page.php below.
#   - HTML pages (every .html file, also when reached by its clean URL) and
#     share-page.php (the post, tournament-details and player-profile
#     routes): "no-cache", so browsers check for a new copy every time and
#     never show a stale page after a deployment (a 304 keeps it quick).
#     The API (api/*.php) and unsubscribe.php keep their own headers.
#   - CSS and JS keep the same file names after a change: short cache
#     (1 hour), so a rebuilt stylesheet reaches visitors the same day
#   - Images and fonts in assets/: 7 days
#   - Uploaded files (uploads/.htaccess) get new random names whenever they
#     change: cached for a year
# ============================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml font/ttf application/font-ttf
</IfModule>
# Fonts (assets/fonts) with the right type on every host
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.html$|^share-page\.php$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
    <FilesMatch "\.(jpe?g|png|webp|gif|svg|ico|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# ============================================
# CORS HEADERS FOR API
# ============================================
<IfModule mod_headers.c>
    # Set CORS headers for API requests
    SetEnvIf Request_URI "^/api/" IS_API
    Header always set Access-Control-Allow-Origin "https://kbf-uk.org" env=IS_API
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" env=IS_API
    Header always set Access-Control-Allow-Headers "Content-Type, X-CSRF-Token" env=IS_API
    Header always set Access-Control-Allow-Credentials "true" env=IS_API
</IfModule>

# ============================================
# SECURITY HEADERS
# ============================================
# Every response: no type guessing, only same-site framing, referrer limited
# to the site's origin on other sites, HTTPS remembered for one year (no
# preload), and camera, microphone and location turned off. (The obsolete
# X-XSS-Protection header is no longer sent.)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Content-Security-Policy for the HTML pages (SEC-16). Everything comes from
# the site itself, except these services, used only on the registration page:
#   - Google reCAPTCHA: scripts from www.google.com and www.gstatic.com,
#     its check box shown in a frame from www.google.com
#   - the phone number field (intl-tel-input): script, stylesheet and flag
#     images from cdn.jsdelivr.net
# Inline scripts and styles stay allowed for now (the pages still use them).
# Images may also be data: or blob: (photo previews before upload).
# No plugins (object-src), no other base address, forms only post to the
# site, and only the site itself may show these pages in a frame.
<IfModule mod_headers.c>
    # (share-page.php sends post, tournament-details and player-profile)
    <FilesMatch "\.html$|^share-page\.php$">
        Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: blob: https://cdn.jsdelivr.net https://www.gstatic.com; font-src 'self' data:; connect-src 'self'; frame-src https://www.google.com https://recaptcha.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    </FilesMatch>
</IfModule>

# ============================================
# HTTPS ENFORCEMENT
# ============================================
# Plain http goes to https on the same host. (Links and redirects built in
# PHP use the Website address in Site settings instead.)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ============================================
# MAINTENANCE MODE (Site settings, Super Admin only)
# While storage/maintenance.flag exists, public pages answer 503 with the
# back-soon page (maintenance.html). api/control-site.php writes and
# removes the flag. Visitors with the kbf_staff cookie (set when a staff
# session is confirmed) see the normal site. Sign-in pages, the admin and
# organiser pages, the API, the unsubscribe page and static files keep
# working for everyone.
# ============================================
ErrorDocument 503 /maintenance.html
RewriteCond %{DOCUMENT_ROOT}/storage/maintenance.flag -f
RewriteCond %{HTTP_COOKIE} !(^|;\s*)kbf_staff=1(;|$)
RewriteCond %{REQUEST_URI} !^/(admin|clubadmin|api|assets|js|uploads|storage)(/|$)
RewriteCond %{REQUEST_URI} !^/(login|two-step|change-password|forgot-password|reset-password|maintenance)(\.html)?$
RewriteCond %{REQUEST_URI} !^/unsubscribe\.php$
RewriteCond %{REQUEST_URI} !\.(css|js|png|jpe?g|webp|gif|svg|ico|woff2?|ttf)$ [NC]
RewriteRule ^ - [R=503,L]

# ============================================
# LINK PREVIEWS
# Sharing apps do not run JavaScript: these three pages go through
# share-page.php, which sends the same HTML file with the og: and twitter:
# preview tags filled in. A plain /post.html (no query) is first redirected
# to /post by the rule further down, as before.
# ============================================
RewriteCond %{THE_REQUEST} !^[A-Z]{3,9}\ /[^?\ ]+\.html\ HTTP
RewriteRule ^(post|tournament-details|player-profile)(\.html)?$ share-page.php?page=$1 [L,QSA]

# ============================================
# CLEAN URLs (Remove .html extension)
# ============================================
# Remove .html extension from URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L,QSA]

# Redirect .html URLs to clean URLs (301 permanent)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP
RewriteRule ^([^.]+)\.html$ /$1 [R=301,L]

# ============================================
# UPLOADS DIRECTORY ACCESS
# ============================================
# What can be served from uploads/ is decided by uploads/.htaccess
# (deny by default, images only, no scripts).
# Prevent rewrites for uploads directory
RewriteRule ^uploads/ - [L]


<Files .env>
    Require all denied
</Files>
