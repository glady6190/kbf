# ============================================
# DATABASE SCRIPTS - NO WEB ACCESS
# Run by hand in phpMyAdmin only, never served.
# ============================================

Options -Indexes

<IfModule mod_authz_core.c>
    Require all denied
    # Also inside FilesMatch, so no rule in the root .htaccess can re-open
    # anything in this folder.
    <FilesMatch ".*">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
    <FilesMatch ".*">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
